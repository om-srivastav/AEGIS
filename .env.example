AEGIS_AGENT_ADAPTER=deterministic
AEGIS_REASONING_PROVIDER=deterministic

# Providers: anthropic or gemini. Model IDs must be verified with the role's key.
# Required only for the model Agent Under Test
AEGIS_AUT_PROVIDER=anthropic
AEGIS_AUT_MODEL=
AEGIS_AUT_API_KEY=

# Required only for model-backed diagnosis
AEGIS_DIAG_PROVIDER=anthropic
AEGIS_DIAG_MODEL=
AEGIS_DIAG_API_KEY=

# Optional independent budget overrides
AEGIS_AUT_MAX_STEPS=12
AEGIS_AUT_MAX_TOOL_CALLS=10
AEGIS_AUT_MAX_PROVIDER_REQUESTS=24
AEGIS_AUT_MAX_TOTAL_TOKENS=32768
AEGIS_AUT_MAX_OUTPUT_TOKENS=2048
AEGIS_AUT_WALL_SECONDS=90
AEGIS_AUT_REQUEST_SECONDS=30

AEGIS_DIAG_MAX_STEPS=1
AEGIS_DIAG_MAX_PROVIDER_REQUESTS=2
AEGIS_DIAG_MAX_TOTAL_TOKENS=16384
AEGIS_DIAG_MAX_OUTPUT_TOKENS=4096
AEGIS_DIAG_WALL_SECONDS=60
AEGIS_DIAG_REQUEST_SECONDS=45

AEGIS_RUN_LIVE_TESTS=0
